# Aruba Central MCP — environment variables
# Copy this to .env and fill in your values

# Base URL for your Aruba Central cluster
ARUBA_BASE_URL=https://internal.api.central.arubanetworks.com

# --- Option A: OAuth2 client credentials (recommended) ---
# Obtained from HPE GreenLake > API Gateway > Add API Client
# Token is auto-fetched and refreshed every 2 hours
ARUBA_CLIENT_ID=your_client_id_here
ARUBA_CLIENT_SECRET=your_client_secret_here

# --- Option B: Static bearer token (fallback) ---
# Used only if ARUBA_CLIENT_ID / ARUBA_CLIENT_SECRET are not set
ARUBA_TOKEN=
